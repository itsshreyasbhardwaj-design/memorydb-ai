{
  "name": "@memorydb/core",
  "version": "0.1.0",
  "description": "Core memory engine for MemoryDB AI — storage adapters, embeddings, hybrid retrieval, consolidation, and knowledge graph",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
