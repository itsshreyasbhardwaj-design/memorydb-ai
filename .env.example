# ============================================================================
# MemoryDB AI — environment configuration
#
# Every value below is OPTIONAL. With no .env at all the app runs fully:
# in-memory storage, local embeddings, no API keys, no network, no cost.
# Copy to .env.local and change only what you need.
# ============================================================================

# ---------------------------------------------------------------- storage ---
# "memory" keeps everything in RAM (lost on restart) — perfect for local dev.
# "postgres" persists to PostgreSQL and requires DATABASE_URL.
STORAGE_DRIVER=memory

# Supabase: Project Settings -> Database -> Connection string (URI).
# Apply supabase/migrations/0001_initial_schema.sql before first start.
# DATABASE_URL=postgresql://user:password@host:5432/postgres
DATABASE_POOL_MAX=10
DATABASE_SSL=true

# ------------------------------------------------------------- embeddings ---
# "local"      feature-hashing embedder. Free, offline, deterministic. Default.
# "ollama"     local neural embeddings — also free. Run: ollama pull nomic-embed-text
# "openrouter" / "openai" / "custom"  billable APIs; require EMBEDDING_API_KEY.
#
# Changing the provider or dimensions requires a reindex:
#   await client.reindex({ force: true })
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSIONS=384
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=http://localhost:11434/v1

# ------------------------------------------------------------------ cache ---
# REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300

# ------------------------------------------------------------------- auth ---
# API key for programmatic access. Generate one with:
#   node -e "console.log('mdb_live_' + require('crypto').randomBytes(20).toString('hex'))"
# REQUIRED in production — without it, API-key auth is disabled entirely.
# MEMORYDB_API_KEY=

# Clerk powers dashboard sign-in when both values are set; otherwise the
# dashboard uses a local development identity (refused in production).
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Local exploration only. Refuses to boot in production.
AUTH_DISABLED=false

# ------------------------------------------------------------ rate limits ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WRITE_MAX=60

# ----------------------------------------------------------------- limits ---
MAX_CONTENT_LENGTH=1000000
MAX_BATCH_SIZE=200
MAX_IMPORT_BYTES=52428800

# ---------------------------------------------------------- observability ---
LOG_LEVEL=info
LOG_PRETTY=false
METRICS_ENABLED=true

# -------------------------------------------------------------------- app ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEFAULT_NAMESPACE=default
